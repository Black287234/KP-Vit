@page "{id:int?}"
@model EquipmentBooking.Pages.Employees.EditModel
@{
    ViewData["Title"] = Model.Item.Id == 0 ? "Новый сотрудник" : "Изменение сотрудника";
}
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form method="post" class="card p-4 col-lg-6">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Item.Id" />
    <div class="mb-3"><label asp-for="Item.FullName" class="form-label"></label><input asp-for="Item.FullName" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Item.Department" class="form-label"></label><input asp-for="Item.Department" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Item.Email" class="form-label"></label><input asp-for="Item.Email" class="form-control" /></div>
    <div class="d-flex gap-2"><button class="btn btn-teal">Сохранить</button><a class="btn btn-outline-secondary" asp-page="Index">Отмена</a></div>
</form>
