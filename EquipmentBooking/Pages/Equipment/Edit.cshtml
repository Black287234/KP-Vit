@page "{id:int?}"
@model EquipmentBooking.Pages.Equipment.EditModel
@{
    ViewData["Title"] = Model.Item.Id == 0 ? "Новое оборудование" : "Изменение оборудования";
}
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form method="post" class="card p-4 col-lg-7">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Item.Id" />
    <div class="row">
        <div class="col-md-5 mb-3">
            <label asp-for="Item.InventoryNumber" class="form-label"></label>
            <input asp-for="Item.InventoryNumber" class="form-control" placeholder="INV-0000" />
        </div>
        <div class="col-md-7 mb-3">
            <label asp-for="Item.Category" class="form-label"></label>
            <input asp-for="Item.Category" class="form-control" list="cats" />
            <datalist id="cats">@foreach (var c in Model.Categories) { <option value="@c"></option> }</datalist>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Item.Name" class="form-label"></label>
        <input asp-for="Item.Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Item.Description" class="form-label"></label>
        <textarea asp-for="Item.Description" class="form-control" rows="2"></textarea>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-teal">Сохранить</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Отмена</a>
    </div>
</form>
