<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Бронирование оборудования</title>
    <!-- Bootstrap подключён с CDN, поэтому для оформления нужен интернет -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark app-nav mb-4">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-page="/Index">⏱ Бронирование оборудования</a>
            <ul class="navbar-nav flex-row flex-wrap gap-3">
                <li class="nav-item"><a class="nav-link" asp-page="/Equipment/Index">Каталог</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Availability">Свободно ли?</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Bookings/Create">Забронировать</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Bookings/Index">Брони</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Schedule">График</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Employees/Index">Сотрудники</a></li>
            </ul>
        </div>
    </nav>
    <main class="container pb-5">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="border-top py-3 text-muted small">
        <div class="container">2026 · Модуль бронирования оборудования</div>
    </footer>
</body>
</html>
